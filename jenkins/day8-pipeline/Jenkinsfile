pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )

        timeout(
            time: 60,
            unit: 'MINUTES'
        )
    }

    parameters {
        booleanParam(
            name: 'APPLY_TERRAFORM',
            defaultValue: true,
            description: 'Apply the reviewed Terraform plan.'
        )

        booleanParam(
            name: 'PUSH_LATEST_TAG',
            defaultValue: true,
            description: 'Also publish the Docker image using the latest tag.'
        )
    }

    environment {
        REPO_URL = 'https://github.com/rajeshkumarbasani/devops-100-days.git'
        REPO_BRANCH = 'main'

        DOCKER_REPOSITORY = 'raj358822/day8-node-app'
        DOCKER_APP_DIR = 'docker/day8-app'
        BUILD_CONTEXT = 'docker/day8-app'

        TEST_CONTAINER = 'day8-app-test'
        TEST_PORT = '8088'

        TF_DIR = 'terraform/day8/env/dev'
        TF_STATE_BUCKET = 'raj358822-devops-100-days-tfstate'
        TF_STATE_KEY = 'day8/dev/terraform.tfstate'

        AWS_DEFAULT_REGION = 'ap-south-1'
        AWS_REGION = 'ap-south-1'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        TRIVY_VERSION = '0.72.0'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()

                git(
                    branch: "${REPO_BRANCH}",
                    credentialsId: 'github-token',
                    url: "${REPO_URL}"
                )

                script {
                    env.GIT_SHORT_COMMIT = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.BUILD_DATE_UTC = sh(
                        script: 'date -u +%Y-%m-%dT%H:%M:%SZ',
                        returnStdout: true
                    ).trim()

                    env.IMMUTABLE_TAG = "${BUILD_NUMBER}-${GIT_SHORT_COMMIT}"
                    env.IMMUTABLE_IMAGE = "${DOCKER_REPOSITORY}:${IMMUTABLE_TAG}"
                    env.LATEST_IMAGE = "${DOCKER_REPOSITORY}:latest"
                }

                echo "Immutable image: ${env.IMMUTABLE_IMAGE}"
            }
        }

        stage('Repository Validation') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    test -f "$DOCKER_APP_DIR/Dockerfile"
                    test -f "$DOCKER_APP_DIR/package.json"
                    test -f "$DOCKER_APP_DIR/package-lock.json"
                    test -f "$TF_DIR/backend.tf"
                    test -f "$TF_DIR/main.tf"

                    git diff --check
                '''
            }
        }

        stage('Application Tests') {
            steps {
                dir("${BUILD_CONTEXT}") {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail

                        docker build \
                          --pull \
                          --target test-stage \
                          --tag day8-node-app-test:${BUILD_NUMBER} \
                          .
                    '''
                }
            }
        }

        stage('Build Production Image') {
            steps {
                dir("${BUILD_CONTEXT}") {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail

                        DOCKER_BUILDKIT=1 docker build \
                          --pull \
                          --target runtime-stage \
                          --build-arg BUILD_VERSION="$IMMUTABLE_TAG" \
                          --build-arg BUILD_COMMIT="$GIT_SHORT_COMMIT" \
                          --build-arg BUILD_DATE="$BUILD_DATE_UTC" \
                          --tag "$IMMUTABLE_IMAGE" \
                          --tag "$LATEST_IMAGE" \
                          .
                    '''
                }
            }
        }

        stage('Image Metadata Validation') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    docker image inspect "$IMMUTABLE_IMAGE"

                    IMAGE_USER="$(docker image inspect \
                      --format='{{.Config.User}}' \
                      "$IMMUTABLE_IMAGE")"

                    if [ "$IMAGE_USER" != "node" ]; then
                      echo "Image must run as node. Current user: $IMAGE_USER"
                      exit 1
                    fi

                    IMAGE_SIZE_BYTES="$(docker image inspect \
                      --format='{{.Size}}' \
                      "$IMMUTABLE_IMAGE")"

                    MAX_SIZE_BYTES=$((200 * 1024 * 1024))

                    if [ "$IMAGE_SIZE_BYTES" -gt "$MAX_SIZE_BYTES" ]; then
                      echo "Image exceeds 200 MiB limit: $IMAGE_SIZE_BYTES bytes"
                      exit 1
                    fi

                    echo "Image user: $IMAGE_USER"
                    echo "Image size: $IMAGE_SIZE_BYTES bytes"
                '''
            }
        }

        stage('Container Security Test') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    docker rm -f "$TEST_CONTAINER" 2>/dev/null || true

                    docker run -d \
                      --name "$TEST_CONTAINER" \
                      --read-only \
                      --tmpfs /tmp:size=16m,mode=1777 \
                      --security-opt no-new-privileges:true \
                      --cap-drop ALL \
                      --pids-limit 100 \
                      --memory 256m \
                      --cpus 0.50 \
                      -e NODE_ENV=production \
                      -e APP_VERSION="$IMMUTABLE_TAG" \
                      -p "$TEST_PORT:3000" \
                      "$IMMUTABLE_IMAGE"

                    READY=0

                    for attempt in $(seq 1 30); do
                      if curl \
                        --fail \
                        --silent \
                        --show-error \
                        "http://127.0.0.1:$TEST_PORT/health/ready"
                      then
                        READY=1
                        break
                      fi

                      sleep 2
                    done

                    if [ "$READY" -ne 1 ]; then
                      docker logs "$TEST_CONTAINER"
                      exit 1
                    fi

                    curl \
                      --fail \
                      --silent \
                      --show-error \
                      "http://127.0.0.1:$TEST_PORT/"

                    CONTAINER_USER="$(docker exec "$TEST_CONTAINER" id -u)"

                    if [ "$CONTAINER_USER" = "0" ]; then
                      echo "Container is running as root."
                      exit 1
                    fi

                    docker inspect \
                      --format='Health={{.State.Health.Status}} ReadOnly={{.HostConfig.ReadonlyRootfs}}' \
                      "$TEST_CONTAINER"
                '''
            }
        }

        stage('Trivy Vulnerability Scan') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    mkdir -p reports

                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v "$WORKSPACE/.trivy-cache:/root/.cache/" \
                      -v "$WORKSPACE/reports:/reports" \
                      "aquasec/trivy:${TRIVY_VERSION}" \
                      image \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      --format json \
                      --output /reports/trivy-image.json \
                      "$IMMUTABLE_IMAGE"
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'reports/trivy-image.json',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('Push Docker Hub Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-creds',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''#!/usr/bin/env bash
                        set +x
                        set -euo pipefail

                        echo "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker push "$IMMUTABLE_IMAGE"

                        if [ "$PUSH_LATEST_TAG" = "true" ]; then
                          docker push "$LATEST_IMAGE"
                        fi

                        docker logout
                    '''
                }
            }
        }

        stage('Terraform Format') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    terraform fmt -check -recursive terraform/day8
                '''
            }
        }

        stage('Terraform Init and Validate') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-cred',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    dir("${TF_DIR}") {
                        sh '''#!/usr/bin/env bash
                            set +x
                            set -euo pipefail

                            cat > backend.hcl <<BACKEND
bucket       = "$TF_STATE_BUCKET"
key          = "$TF_STATE_KEY"
region       = "$AWS_DEFAULT_REGION"
use_lockfile = true
encrypt      = true
BACKEND

                            terraform init \
                              -reconfigure \
                              -backend-config=backend.hcl

                            terraform validate
                        '''
                    }
                }
            }
        }

        stage('Terraform Security Check') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    docker run --rm \
                      -v "$WORKSPACE:/workspace" \
                      -w /workspace \
                      "aquasec/trivy:${TRIVY_VERSION}" \
                      config \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      terraform/day8
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-cred',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    dir("${TF_DIR}") {
                        sh '''#!/usr/bin/env bash
                            set +x
                            set -euo pipefail

                            terraform plan \
                              -lock-timeout=5m \
                              -var="docker_image=$IMMUTABLE_IMAGE" \
                              -out=tfplan

                            terraform show \
                              -no-color \
                              tfplan > tfplan.txt
                        '''
                    }
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'terraform/day8/env/dev/tfplan.txt',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Approval') {
            when {
                expression {
                    return params.APPLY_TERRAFORM
                }
            }

            options {
                timeout(
                    time: 15,
                    unit: 'MINUTES'
                )
            }

            steps {
                input(
                    message: "Deploy ${env.IMMUTABLE_IMAGE} to Day 8 dev?",
                    ok: 'Deploy',
                    submitterParameter: 'APPROVED_BY'
                )
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return params.APPLY_TERRAFORM
                }
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-cred',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    dir("${TF_DIR}") {
                        sh '''#!/usr/bin/env bash
                            set +x
                            set -euo pipefail

                            terraform apply \
                              -lock-timeout=5m \
                              -auto-approve \
                              tfplan

                            terraform output -json > terraform-output.json

                            terraform output -raw application_url \
                              > application-url.txt

                            terraform output -raw health_url \
                              > health-url.txt
                        '''
                    }
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'terraform/day8/env/dev/terraform-output.json',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Deployment Verification') {
            when {
                expression {
                    return params.APPLY_TERRAFORM
                }
            }

            steps {
                dir("${TF_DIR}") {
                    sh '''#!/usr/bin/env bash
                        set -euo pipefail

                        APPLICATION_URL="$(cat application-url.txt)"
                        HEALTH_URL="$(cat health-url.txt)"

                        echo "Application URL: $APPLICATION_URL"
                        echo "Health URL: $HEALTH_URL"

                        DEPLOYED=0

                        for attempt in $(seq 1 60); do
                          if curl \
                            --fail \
                            --silent \
                            --show-error \
                            --connect-timeout 5 \
                            --max-time 10 \
                            "$HEALTH_URL"
                          then
                            DEPLOYED=1
                            break
                          fi

                          echo "Waiting for application: attempt $attempt/60"
                          sleep 10
                        done

                        if [ "$DEPLOYED" -ne 1 ]; then
                          echo "Application failed its deployment health check."
                          exit 1
                        fi

                        curl \
                          --fail \
                          --silent \
                          --show-error \
                          "$APPLICATION_URL"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Day 8 completed successfully."
            echo "Published image: ${env.IMMUTABLE_IMAGE}"
        }

        failure {
            echo "Day 8 pipeline failed. Review the failed stage and archived reports."
        }

        aborted {
            echo "Day 8 pipeline was aborted."
        }

        always {
            sh '''#!/usr/bin/env bash
                docker rm -f "$TEST_CONTAINER" 2>/dev/null || true
                docker logout 2>/dev/null || true

                rm -f "$TF_DIR/backend.hcl"
                rm -f "$TF_DIR/tfplan"

                docker image rm \
                  "day8-node-app-test:${BUILD_NUMBER}" \
                  2>/dev/null || true

                docker image prune -f || true
            '''

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }
    }
}