pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        REPO_URL         = "https://github.com/rajeshkumarbasani/devops-100-days.git"
        DOCKER_IMAGE    = "raj358822/day7-nginx-app"
        DOCKER_TAG      = "${BUILD_NUMBER}"
        DOCKER_LATEST   = "latest"
        APP_CONTAINER   = "day7-app-test"
        APP_PORT        = "8087"
        TF_DIR          = "terraform/day7/env/dev"
        AWS_DEFAULT_REGION = "ap-south-1"
    }

    stages {
        stage('Checkout From GitHub') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: "${REPO_URL}"
            }
        }

        stage('Docker Build') {
            steps {
                dir('docker/day7-app') {
                    sh '''
                      docker build \
                        --no-cache \
                        -t $DOCKER_IMAGE:$DOCKER_TAG \
                        -t $DOCKER_IMAGE:$DOCKER_LATEST .
                    '''
                }
            }
        }

        stage('Docker Local Test') {
            steps {
                sh '''
                  docker rm -f $APP_CONTAINER || true

                  docker run -d \
                    --name $APP_CONTAINER \
                    -p $APP_PORT:8080 \
                    $DOCKER_IMAGE:$DOCKER_TAG

                  sleep 5

                  curl -f http://localhost:$APP_PORT
                  curl -f http://localhost:$APP_PORT/health
                '''
            }
        }

        stage('Docker Hub Login and Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASS'
                    )
                ]) {
                    sh '''
                      echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin

                      docker push $DOCKER_IMAGE:$DOCKER_TAG
                      docker push $DOCKER_IMAGE:$DOCKER_LATEST

                      docker logout
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh 'terraform init'
                    }
                }
            }
        }

        stage('Terraform Format and Validate') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                          terraform fmt -check -recursive
                          terraform validate
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh '''
                          terraform plan \
                            -var="docker_image=$DOCKER_IMAGE:$DOCKER_LATEST" \
                            -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Manual Approval') {
            steps {
                input message: 'Approve Day 7 Terraform Apply?'
            }
        }

        stage('Terraform Apply') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh 'terraform apply -auto-approve tfplan'
                    }
                }
            }
        }

        stage('Terraform Output') {
            steps {
                dir("${TF_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        sh 'terraform output'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Day 7 pipeline completed successfully.'
        }

        failure {
            echo 'Day 7 pipeline failed.'
        }

        always {
            sh '''
              docker rm -f $APP_CONTAINER || true
              docker image prune -f || true
            '''
        }
    }
}